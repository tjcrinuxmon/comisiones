# Copia este archivo a .env y ajusta los valores.
# Puerto interno de la app (nginx hace reverse proxy hacia aquí; no se expone al exterior).
PORT=3006
# Interfaz de escucha. Detrás de nginx, ponlo en 127.0.0.1 para que el puerto
# deje de ser alcanzable por IP y todo el tráfico entre cifrado por el proxy.
# Sin esta línea escucha en todas las interfaces (0.0.0.0), como hasta ahora.
#HOST=127.0.0.1
# Clave del administrador (la que desbloquea toda la funcionalidad). CÁMBIALA.
ADMIN_PASS=cambia-esta-clave
